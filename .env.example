APP_ENV=development

POSTGRES_USER=cmpdi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cmpdi_reports
DATABASE_URL=postgresql+psycopg://cmpdi:change-me@postgres:5432/cmpdi_reports

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=documents
MINIO_SECURE=false

JWT_SECRET_KEY=change-this-local-dev-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

DEFAULT_ADMIN_EMAIL=admin@cmpdi.local
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-local-password
DEFAULT_ADMIN_FULL_NAME=CMPDI Demo Admin

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

QA_MODE=local_extractive
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY=

DATA_QUALITY_GROUND_TRUTH_PATH=/samples/demo/evaluation/ground_truth.json
WORKFLOW_MANUAL_BASELINE_PATH=/samples/demo/evaluation/manual_baseline_assumptions.json
WORKFLOW_BENCHMARK_PATH=/samples/demo/evaluation/workflow_benchmark.json

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
